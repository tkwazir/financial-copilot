# Copy this file to .env and fill in your values. .env is gitignored — never commit real credentials.

# Account identifier, e.g. "ABCD-EFG12345" (new format) or "xy12345.us-east-1" (legacy locator)
SNOWFLAKE_ACCOUNT=

SNOWFLAKE_USER=

# Auth is via RSA key-pair, not password (this account enforces MFA on
# password-based connector logins). Generate a key pair and register the
# public key with your user — see root README "Snowflake Auth Setup".
# snowflake/conn.py expects the private key at .secrets/snowflake_rsa_key.p8.

SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=FIN_COPILOT_WH
SNOWFLAKE_DATABASE=FIN_COPILOT

# Used by dbt/profiles.yml — absolute path to the private key file above
SNOWFLAKE_PRIVATE_KEY_PATH=
